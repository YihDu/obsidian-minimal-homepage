{
  "name": "minimal-homepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --external:obsidian --platform=node --format=cjs --target=es2022 --minify --outfile=main.js",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "build:apple-helper": "bash apple-helper/build.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.9.0"
  }
}
